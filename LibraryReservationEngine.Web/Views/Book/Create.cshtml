@model LibraryReservationEngine.Web.Models.BookFormViewModel

@{
    ViewData["Title"] = "Add Book";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <!-- Centered Off-White Card -->
            <div class="card-offwhite p-4 p-md-5">
                <div class="mb-4 text-center">
                    <span class="label-caps">Catalogue Management</span>
                    <h2 class="h3 mb-1">Add Book</h2>
                    <p class="text-muted small">Enter book metadata to register the title into catalogue.</p>
                </div>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 mb-3 small"></div>

                    <div class="mb-4">
                        <label asp-for="Title" class="form-label label-caps">Title</label>
                        <input asp-for="Title" class="form-control form-control-underline" placeholder="e.g. Clean Code" required />
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ISBN" class="form-label label-caps">ISBN</label>
                        <input asp-for="ISBN" class="form-control form-control-underline" placeholder="e.g. 978-0132350884" required />
                        <span asp-validation-for="ISBN" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AuthorName" class="form-label label-caps">Author</label>
                        <input asp-for="AuthorName" class="form-control form-control-underline" placeholder="e.g. Robert C. Martin" required />
                        <span asp-validation-for="AuthorName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="CategoryName" class="form-label label-caps">Category</label>
                        <input asp-for="CategoryName" class="form-control form-control-underline" placeholder="e.g. Software Engineering" required />
                        <span asp-validation-for="CategoryName" class="text-danger small"></span>
                    </div>

                    <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="text-muted small text-decoration-none">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>