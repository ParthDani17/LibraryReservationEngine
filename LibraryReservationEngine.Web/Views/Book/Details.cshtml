@model LibraryReservationEngine.Domain.Entities.Book
@inject LibraryReservationEngine.Application.Interfaces.IReservationService ReservationService

@{
    ViewData["Title"] = Model.Title;
}

<div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="label-caps">Book Details</span>
            <h1 class="h2 mb-0">@Model.Title</h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-dark btn-sm">&larr; Back to Catalogue</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Two-Column Layout -->
    <div class="row g-4">
        <!-- Left Column: Book Metadata Card (+ Active Student Holds if Librarian) -->
        <div class="col-lg-7">
            <div class="card p-4 mb-4">
                <span class="label-caps mb-3 d-block">Book Metadata</span>
                
                <div class="row mb-3">
                    <div class="col-sm-3 label-caps pt-1">Author</div>
                    <div class="col-sm-9 fw-semibold text-dark">@(Model.Author?.Name ?? "Unknown")</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-3 label-caps pt-1">Category</div>
                    <div class="col-sm-9">
                        <span class="badge badge-maintenance">@(Model.Category?.Name ?? "General")</span>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-sm-3 label-caps pt-1">ISBN</div>
                    <div class="col-sm-9">
                        <code class="px-2 py-1 bg-light rounded text-dark" style="font-size: 0.95rem; border: 1px solid var(--border-grey);">@Model.ISBN</code>
                    </div>
                </div>

                <div class="pt-3 border-top">
                    @if (User.IsInRole("Member"))
                    {
                        <form asp-controller="Reservation" asp-action="Create" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="bookId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary px-4 py-2">
                                Reserve this Book
                            </button>
                        </form>
                    }
                    else if (User.IsInRole("Librarian"))
                    {
                        <span class="badge badge-maintenance py-2 px-3">Librarian mode: reserve is restricted to students</span>
                    }
                    else
                    {
                        <p class="mb-0 text-muted small">
                            <a asp-controller="Account" asp-action="Login" class="fw-semibold text-dark">Log in as a student</a> to reserve this title.
                        </p>
                    }
                </div>
            </div>

            @if (User.IsInRole("Librarian"))
            {
                var activeReservations = await ReservationService.GetActiveReservationsForBookAsync(Model.Id);
                <div class="card p-0">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <span class="label-caps d-block mb-1">Queue Management</span>
                            <span class="fw-semibold">Active Student Reservations (@activeReservations.Count())</span>
                        </div>
                        <a asp-controller="Reservation" asp-action="Index" class="btn btn-outline-dark btn-sm">View All Queue</a>
                    </div>
                    <div class="card-body p-0">
                        @if (!activeReservations.Any())
                        {
                            <div class="p-4 text-muted small text-center">No active student holds for this book.</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>Student</th>
                                            <th>Copy Code</th>
                                            <th>Hold Expires</th>
                                            <th class="text-end">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var res in activeReservations)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-semibold text-dark">@res.MemberName</div>
                                                    <small class="text-muted">@res.MemberEmail</small>
                                                </td>
                                                <td><code>@res.CopyCode</code></td>
                                                <td class="small">@(res.ExpiresAt.HasValue ? res.ExpiresAt.Value.ToLocalTime().ToString("MMM dd, HH:mm") : "—")</td>
                                                <td class="text-end">
                                                    <form asp-controller="Borrowing" asp-action="Issue" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="reservationId" value="@res.Id" />
                                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                        <button type="submit" class="btn btn-outline-success btn-sm">
                                                            Issue Book
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right Column: Physical Copies Card -->
        <div class="col-lg-5">
            <div class="card p-0">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <span class="label-caps d-block mb-0">Inventory</span>
                        <span class="fw-semibold">Physical Copies</span>
                    </div>
                    @if (User.IsInRole("Librarian"))
                    {
                        <div class="d-flex gap-2">
                            <a asp-controller="BookCopy" asp-action="Index" asp-route-bookId="@Model.Id" class="btn btn-outline-dark btn-sm">
                                Manage Copies
                            </a>
                            <a asp-action="History" asp-route-id="@Model.Id" class="btn btn-outline-dark btn-sm">
                                View Borrow History
                            </a>
                        </div>
                    }
                </div>
                <div class="card-body p-0">
                    @if (!Model.BookCopies.Any())
                    {
                        <div class="p-4 text-muted small text-center">No physical copies registered for this title.</div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush rounded-0">
                            @foreach (var copy in Model.BookCopies)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center px-4 py-3 border-bottom">
                                    <code class="fw-semibold text-dark" style="font-size: 0.95rem;">@copy.CopyCode</code>
                                    @switch (copy.Status)
                                    {
                                        case LibraryReservationEngine.Domain.Enums.BookCopyStatus.Available:
                                            <span class="badge badge-available">Available</span>
                                            break;
                                        case LibraryReservationEngine.Domain.Enums.BookCopyStatus.Reserved:
                                            <span class="badge badge-reserved">Reserved</span>
                                            break;
                                        case LibraryReservationEngine.Domain.Enums.BookCopyStatus.Borrowed:
                                            <span class="badge badge-borrowed">Borrowed</span>
                                            break;
                                        case LibraryReservationEngine.Domain.Enums.BookCopyStatus.Maintenance:
                                            <span class="badge badge-maintenance">Maintenance</span>
                                            break;
                                        default:
                                            <span class="badge badge-maintenance">@copy.Status</span>
                                            break;
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>