@model LibraryReservationEngine.Domain.Entities.Book

<h2>@Model.Title</h2>
<p><strong>Author:</strong> @Model.Author?.Name</p>
<p><strong>Category:</strong> @Model.Category?.Name</p>
<p><strong>ISBN:</strong> @Model.ISBN</p>
@if (User.Identity?.IsAuthenticated == true)
{
    <form asp-controller="Reservation" asp-action="Create" method="post" style="display:inline">
        <input type="hidden" name="bookId" value="@Model.Id" />
        <button type="submit">Reserve this Book</button>
    </form>
}
else
{
    <p><a asp-controller="Account" asp-action="Login">Log in</a> to reserve this book.</p>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<h4>Copies</h4>
<ul>
    @foreach (var copy in Model.BookCopies)
    {
        <li>@copy.CopyCode — @copy.Status</li>
    }
</ul>
@if (User.IsInRole("Librarian"))
{
    <a asp-controller="BookCopy" asp-action="Index" asp-route-bookId="@Model.Id">Manage Copies</a>
}
<a asp-action="Index">Back to list</a>