@model LibraryReservationEngine.Domain.Entities.Book

<h2>@Model.Title</h2>
<p><strong>Author:</strong> @Model.Author?.Name</p>
<p><strong>Category:</strong> @Model.Category?.Name</p>
<p><strong>ISBN:</strong> @Model.ISBN</p>

<h4>Copies</h4>
<ul>
    @foreach (var copy in Model.BookCopies)
    {
        <li>@copy.CopyCode — @copy.Status</li>
    }
</ul>
@if (User.IsInRole("Librarian"))
{
    <a asp-controller="BookCopy" asp-action="Index" asp-route-bookId="@Model.Id">Manage Copies</a>
}
<a asp-action="Index">Back to list</a>