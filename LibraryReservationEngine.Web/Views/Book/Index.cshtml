@model IEnumerable<LibraryReservationEngine.Web.Models.BookListItemViewModel>

<h2>Books</h2>

<form asp-action="Index" method="get" class="mb-3">
    <input type="text" name="query" value="@ViewData["Query"]" placeholder="Search by title, author, category..." />
    <button type="submit">Search</button>
</form>

<a asp-action="Create">+ Add New Book</a>

<table class="table">
    <thead>
        <tr>
            <th>Title</th><th>Author</th><th>Category</th><th>Availability</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>@book.Title</td>
                <td>@book.AuthorName</td>
                <td>@book.CategoryName</td>
                <td>@book.AvailableCopies / @book.TotalCopies available</td>
                <td>
                    <a asp-action="Details" asp-route-id="@book.Id">View</a> |
                    <a asp-action="Edit" asp-route-id="@book.Id">Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>