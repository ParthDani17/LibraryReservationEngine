@model IEnumerable<LibraryReservationEngine.Web.Models.BookListItemViewModel>

@{
    ViewData["Title"] = "Books";
}

<div class="container">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <span class="label-caps">Catalogue Directory</span>
            <h1 class="h2 mb-0">Books</h1>
        </div>
        @if (User.IsInRole("Librarian"))
        {
            <a asp-action="Create" class="btn btn-primary">
                + Add New Book
            </a>
        }
    </div>

    <!-- Wide Editorial Search Bar -->
    <form asp-action="Index" method="get" class="editorial-search-bar mb-4">
        <input type="text" name="query" value="@ViewData["Query"]" placeholder="Search by title, author, category..." />
        <button type="submit">Search</button>
    </form>

    <div class="card p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 35%;">Title</th>
                        <th style="width: 25%;">Author</th>
                        <th style="width: 15%;">Category</th>
                        <th style="width: 15%;">Availability</th>
                        <th style="width: 10%;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No books found matching your criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var book in Model)
                        {
                            var badgeClass = book.AvailableCopies > 0 
                                ? "badge-available" 
                                : (book.TotalCopies > 0 ? "badge-reserved" : "badge-maintenance");
                            var statusText = book.AvailableCopies > 0 
                                ? "Available" 
                                : (book.TotalCopies > 0 ? "Reserved" : "Maintenance");

                            <tr>
                                <td class="fw-semibold">
                                    <a asp-action="Details" asp-route-id="@book.Id" class="text-dark text-decoration-none">
                                        @book.Title
                                    </a>
                                </td>
                                <td class="text-muted">@book.AuthorName</td>
                                <td>
                                    <span class="small text-secondary">@book.CategoryName</span>
                                </td>
                                <td>
                                    <div class="d-inline-flex align-items-center gap-2">
                                        <span class="badge @badgeClass">@statusText</span>
                                        <span class="small text-muted">@book.AvailableCopies / @book.TotalCopies available</span>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2 align-items-center">
                                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-outline-dark btn-sm">View</a>
                                        @if (User.IsInRole("Librarian"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-outline-dark btn-sm">Edit</a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>