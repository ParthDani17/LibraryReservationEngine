@model LibraryReservationEngine.Web.Models.BookFormViewModel

<h2>Edit Book</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div>
        <label>Title</label>
        <input asp-for="Title" />
    </div>
    <div>
        <label>ISBN</label>
        <input asp-for="ISBN" />
    </div>
    <div>
        <label>Author</label>
        <input asp-for="AuthorName" />
    </div>
    <div>
        <label>Category</label>
        <input asp-for="CategoryName" />
    </div>
    <button type="submit">Save</button>
</form>