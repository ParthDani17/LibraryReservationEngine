@model LibraryReservationEngine.Web.Models.DashboardViewModel

@{
    ViewData["Title"] = "Librarian Dashboard";
}

<div class="container">
    <div class="mb-4">
        <span class="label-caps">Administration</span>
        <h1 class="h2 mb-0">Librarian Dashboard</h1>
    </div>

    <!-- Top Row of Four Large Stat Cards (Overdue Borrowings in red) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-label">Total Books</div>
                <div class="stat-value">@Model.TotalBooks</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-label">Total Copies</div>
                <div class="stat-value">@Model.TotalCopies</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-label">Registered Members</div>
                <div class="stat-value">@Model.TotalRegisteredMembers</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-danger">
                <div class="stat-label">Overdue Borrowings</div>
                <div class="stat-value">@Model.OverdueBorrowings</div>
            </div>
        </div>
    </div>

    <!-- Second Row with Colored Stat Cards: Available (green), Borrowed (charcoal), Reserved (amber), Maintenance (grey) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-available">
                <div class="stat-label">Available Copies</div>
                <div class="stat-value">@Model.AvailableCopies</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-borrowed">
                <div class="stat-label">Borrowed Copies</div>
                <div class="stat-value">@Model.BorrowedCopies</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-reserved">
                <div class="stat-label">Reserved Copies</div>
                <div class="stat-value">@Model.ReservedCopies</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card stat-maintenance">
                <div class="stat-label">In Maintenance</div>
                <div class="stat-value">@Model.MaintenanceCopies</div>
            </div>
        </div>
    </div>

    <!-- Third Row: Active Reservations, Active Waitlist Entries, Outstanding Fines in rupees (red) -->
    <div class="row g-3">
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-label">Active Reservations</div>
                <div class="stat-value">@Model.ActiveReservations</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card">
                <div class="stat-label">Active Waitlist Entries</div>
                <div class="stat-value">@Model.ActiveWaitlistEntries</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card stat-danger">
                <div class="stat-label">Outstanding Fines</div>
                <div class="stat-value">₹@Model.TotalOutstandingFines.ToString("N2")</div>
            </div>
        </div>
    </div>
</div>