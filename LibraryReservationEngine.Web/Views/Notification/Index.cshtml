@model IEnumerable<LibraryReservationEngine.Application.Common.NotificationSummaryDto>

@{
    ViewData["Title"] = "Notifications";
    var notificationsList = Model.ToList();
    var unreadCount = notificationsList.Count(n => !n.IsRead);
}

<div class="container py-4">
    <!-- Header with Stats & Actions -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-2 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <div class="brand-icon-box" style="width: 36px; height: 36px; font-size: 1.1rem; border-radius: 10px;">
                    <i class="bi bi-bell-fill"></i>
                </div>
                <h2 class="mb-0 fw-bold" style="color: var(--color-midnight);">Notifications</h2>
                @if (unreadCount > 0)
                {
                    <span class="badge rounded-pill bg-danger ms-1">@unreadCount new</span>
                }
            </div>
            <p class="text-muted small mt-1 mb-0">Stay updated on your book reservations, loan statuses, and fine notices.</p>
        </div>

        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-brand-outline">
                    <i class="bi bi-check2-all"></i> Mark All as Read
                </button>
            </form>
        }
    </div>

    <!-- Alert Feedback -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Notifications List -->
    @if (!notificationsList.Any())
    {
        <div class="text-center py-5">
            <div class="mb-3">
                <i class="bi bi-bell-slash text-muted" style="font-size: 3.5rem; opacity: 0.5;"></i>
            </div>
            <h5 class="fw-bold" style="color: var(--color-midnight);">No Notifications Yet</h5>
            <p class="text-muted small max-w-sm mx-auto">
                When you reserve books, receive issued loans, or settle fines, important updates will appear here.
            </p>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10">
                <div class="d-flex flex-column gap-3">
                    @foreach (var n in notificationsList)
                    {
                        var isUnread = !n.IsRead;
                        var cardBg = isUnread ? "rgba(235, 211, 248, 0.22)" : "#FFFFFF";
                        var borderStyle = isUnread ? "2px solid var(--color-orchid)" : "1px solid var(--border-subtle)";

                        <div class="card shadow-sm transition-all" style="background: @cardBg; border: @borderStyle; border-radius: 14px;">
                            <div class="card-body p-3 p-md-4">
                                <div class="d-flex align-items-start gap-3">
                                    <!-- Category Icon -->
                                    <div class="flex-shrink-0">
                                        @switch (n.Type)
                                        {
                                            case LibraryReservationEngine.Domain.Enums.NotificationType.BookReserved:
                                            case LibraryReservationEngine.Domain.Enums.NotificationType.ReservationReady:
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(122, 28, 172, 0.12); color: var(--color-royal); font-size: 1.25rem;">
                                                    <i class="bi bi-bookmark-check-fill"></i>
                                                </div>
                                                break;
                                            case LibraryReservationEngine.Domain.Enums.NotificationType.BookIssued:
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(25, 135, 84, 0.12); color: #198754; font-size: 1.25rem;">
                                                    <i class="bi bi-journal-arrow-down"></i>
                                                </div>
                                                break;
                                            case LibraryReservationEngine.Domain.Enums.NotificationType.BookReturned:
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(13, 110, 253, 0.12); color: #0d6efd; font-size: 1.25rem;">
                                                    <i class="bi bi-journal-arrow-up"></i>
                                                </div>
                                                break;
                                            case LibraryReservationEngine.Domain.Enums.NotificationType.FineIssued:
                                            case LibraryReservationEngine.Domain.Enums.NotificationType.OverdueReminder:
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(220, 53, 69, 0.12); color: #dc3545; font-size: 1.25rem;">
                                                    <i class="bi bi-exclamation-octagon-fill"></i>
                                                </div>
                                                break;
                                            case LibraryReservationEngine.Domain.Enums.NotificationType.FinePaid:
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(25, 135, 84, 0.12); color: #198754; font-size: 1.25rem;">
                                                    <i class="bi bi-cash-coin"></i>
                                                </div>
                                                break;
                                            case LibraryReservationEngine.Domain.Enums.NotificationType.WaitlistPromoted:
                                            case LibraryReservationEngine.Domain.Enums.NotificationType.WaitlistJoined:
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(255, 193, 7, 0.2); color: #b78103; font-size: 1.25rem;">
                                                    <i class="bi bi-people-fill"></i>
                                                </div>
                                                break;
                                            case LibraryReservationEngine.Domain.Enums.NotificationType.ReservationCancelled:
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(108, 117, 125, 0.12); color: #6c757d; font-size: 1.25rem;">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                </div>
                                                break;
                                            default:
                                                <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: rgba(122, 28, 172, 0.12); color: var(--color-royal); font-size: 1.25rem;">
                                                    <i class="bi bi-bell-fill"></i>
                                                </div>
                                                break;
                                        }
                                    </div>

                                    <!-- Content & Actions -->
                                    <div class="flex-grow-1">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-1">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge" style="background-color: var(--color-royal); font-size: 0.75rem;">
                                                    @n.TypeName
                                                </span>
                                                @if (isUnread)
                                                {
                                                    <span class="badge bg-danger" style="font-size: 0.7rem;">New</span>
                                                }
                                            </div>
                                            <small class="text-muted">
                                                <i class="bi bi-clock me-1"></i>@n.CreatedAt.ToLocalTime().ToString("MMM dd, yyyy · hh:mm tt")
                                            </small>
                                        </div>

                                        <p class="mb-2 text-dark" style="font-size: 0.95rem; font-weight: @(isUnread ? "600" : "400");">
                                            @n.Message
                                        </p>

                                        @if (isUnread)
                                        {
                                            <div class="d-flex justify-content-end">
                                                <form asp-action="MarkAsRead" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@n.Id" />
                                                    <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none" style="color: var(--color-royal); font-size: 0.85rem; font-weight: 600;">
                                                        <i class="bi bi-check2"></i> Mark as read
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
