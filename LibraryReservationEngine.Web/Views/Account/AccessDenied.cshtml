@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="row justify-content-center py-5">
        <div class="col-md-6 text-center py-5">
            <!-- Large "403" in Charcoal -->
            <div style="font-family: 'Playfair Display', Georgia, serif; font-size: 7rem; font-weight: 700; color: var(--text-charcoal); line-height: 1; letter-spacing: -0.04em;">
                403
            </div>

            <div class="my-4">
                <span class="label-caps">Access Restricted</span>
                <h2 class="h4 mt-2 mb-2">Access Denied</h2>
                <p class="text-muted">You don't have permission to view this page.</p>
            </div>

            <div class="pt-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                    Back to Home
                </a>
            </div>
        </div>
    </div>
</div>