@model LibraryReservationEngine.Web.Models.RegisterViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <!-- Institutional Badge Header -->
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-2 rounded-pill" style="background: #EAE6DF; border: 1px solid var(--border-grey);">
                    <span class="overdue-dot" style="background-color: var(--badge-available); margin-right: 0;"></span>
                    <span class="label-caps" style="color: var(--text-charcoal); font-size: 0.7rem; margin-bottom: 0;">Campus Library Portal</span>
                </div>
                <h1 class="h3 fw-bold mb-1" style="color: var(--text-charcoal);">Create Account</h1>
                <p class="text-secondary small mb-0">Register your student account to borrow and reserve books online.</p>
            </div>

            <!-- Clean, Professional Form Card (No Photos) -->
            <div class="card p-4 p-md-5" style="box-shadow: 0 4px 20px rgba(26,26,26,0.06); border: 1px solid var(--border-grey);">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 mb-3 small" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label label-caps mb-1">Full Name</label>
                        <input asp-for="FullName" 
                               class="form-control" 
                               placeholder="e.g. Alex Johnson" 
                               autocomplete="name" 
                               required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label label-caps mb-1">University Email Address</label>
                        <input asp-for="Email" 
                               class="form-control" 
                               placeholder="e.g. alex@university.edu" 
                               autocomplete="email" 
                               required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label label-caps mb-1">Password</label>
                        <input asp-for="Password" 
                               class="form-control" 
                               placeholder="••••••••" 
                               autocomplete="new-password" 
                               required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label label-caps mb-1">Confirm Password</label>
                        <input asp-for="ConfirmPassword" 
                               class="form-control" 
                               placeholder="••••••••" 
                               autocomplete="new-password" 
                               required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mb-3 fw-semibold">
                        Create Account &rarr;
                    </button>

                    <div class="text-center pt-3 border-top" style="font-size: 0.85rem;">
                        <span class="text-secondary">Already have an account?</span>
                        <a asp-controller="Account" asp-action="Login" class="text-dark fw-semibold text-decoration-none ms-1">
                            Sign in here
                        </a>
                    </div>
                </form>
            </div>

            <!-- Security & Back Link -->
            <div class="d-flex justify-content-between align-items-center mt-4 px-2" style="font-size: 0.8rem; color: #8A8F98;">
                <a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none">
                    &larr; Back to Home
                </a>
                <span>
                    <i class="bi bi-shield-check me-1"></i>Official Library Registration
                </span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}