@{
    ViewData["Title"] = "Page Not Found";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="card shadow-sm border-0 p-4 p-md-5">
                <div class="mb-3 text-warning">
                    <i class="bi bi-compass" style="font-size: 3.5rem;"></i>
                </div>
                <div class="badge bg-warning-subtle text-warning fw-semibold px-3 py-2 rounded-pill mx-auto mb-3">404 Error</div>
                <h1 class="h3 fw-bold mb-2">Page Not Found</h1>
                <p class="text-muted mb-4">
                    The catalogue page or resource you are looking for may have been moved, renamed, or is temporarily unavailable.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Book" asp-action="Index" class="btn btn-primary px-4">
                        <i class="bi bi-book me-1"></i> Browse Books
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-house-door me-1"></i> Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

