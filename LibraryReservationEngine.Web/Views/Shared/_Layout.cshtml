<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LibraryReservationEngine.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryReservationEngine.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="navbar-text me-3" style="margin: auto">
                    Hello, @User.Identity.Name
                </span>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-dark me-4">
                        Logout
                    </button>
                </form>

                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Reservation" asp-action="MyReservations">My Reservations</a>
                </li>
            }
            else
            {
                <a class="nav-link me-4" style="margin: auto"
                   asp-controller="Account"
                   asp-action="Login">
                    Login
                </a>

                <a class="btn btn-secondary me-4"
                   asp-controller="Account"
                   asp-action="Register">
                    Register
                </a>
            }
            <li class="nav-item">
                <a class="nav-link text-dark" asp-controller="Book" asp-action="Index">Books</a>
            </li>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - LibraryReservationEngine.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
